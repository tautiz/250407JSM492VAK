#!/bin/bash

# Universal Setup Launcher
# Automatically detects OS and runs appropriate setup script

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Detect operating system
detect_os() {
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        echo "linux"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "win32" ]]; then
        echo "windows"
    else
        echo "unknown"
    fi
}

main() {
    print_status "Universal Environment Setup Launcher"
    print_status "====================================="
    
    OS=$(detect_os)
    print_status "Detected OS: $OS"
    
    case $OS in
        "linux"|"macos")
            if [ -f "setup.sh" ]; then
                print_status "Running Unix setup script..."
                chmod +x setup.sh
                ./setup.sh
            else
                print_error "setup.sh not found!"
                exit 1
            fi
            ;;
        "windows")
            print_status "Windows detected. Please run one of these commands:"
            echo "  setup.bat       - Batch script"
            echo "  setup.ps1       - PowerShell script"
            echo "  node setup.js   - Node.js script (if Node.js installed)"
            ;;
        *)
            print_warning "Unknown operating system: $OS"
            print_status "Trying to run Node.js setup script..."
            if command -v node >/dev/null 2>&1; then
                node setup.js
            else
                print_error "Node.js not found. Please install Node.js first or run the appropriate setup script manually."
                exit 1
            fi
            ;;
    esac
}

main "$@"
